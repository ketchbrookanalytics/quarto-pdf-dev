// https://github.com/rocker-org/devcontainer-features
{
	"name": "My Awesome Report",
	// Pull the pre-built base image from ghcr.io instead of building it
	// locally. The image is published by .github/workflows/publish-image.yml.
	// Requires the ghcr.io package to be public (or `docker login ghcr.io`).
	"image": "ghcr.io/ketchbrookanalytics/quarto-pdf-dev:latest",

	// Install the GitHub CLI, so `gh` is available for issues and pull
	// requests from inside the container.
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	// Keep the GitHub CLI and Claude Code credentials in named Docker volumes
	// rather than in bind mounts to the host. Docker creates a named volume on
	// first use, so this needs no host-side setup step and behaves the same on
	// a Windows, macOS, or Linux host. The volumes outlive "Rebuild Container",
	// so you sign in once rather than once per rebuild. The names are fixed
	// rather than per-project, so every report built from this template shares
	// one login; append `-${devcontainerId}` to either name to isolate a
	// project instead.
	"mounts": [
		"source=quarto-pdf-dev-gh,target=/root/.config/gh,type=volume",
		"source=quarto-pdf-dev-claude,target=/root/.claude,type=volume"
	],

	// Claude Code keeps its token in ~/.claude/.credentials.json but its
	// account and onboarding state in ~/.claude.json, which is outside the
	// volume above. Pointing its config directory at the volume keeps both, so
	// a rebuild doesn't send you back through sign-in.
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/root/.claude"
	},

	// Install system dependencies and the Air CLI. VS Code waits for this step
	// before activating extensions, so the Air extension finds `air` on PATH.
	// It always finishes before `postCreateCommand` starts, so their apt-get
	// calls can't overlap.
	"onCreateCommand": ["bash", ".devcontainer/onCreate.sh"],

	// Install the `arf` R terminal and R packages for developing in VScode.
	// Run as a single sequential script (rather than the object form, whose
	// entries run in parallel) so arf's install can't race pak's apt-get
	// sysreqs installation.
	"postCreateCommand": [
		"bash",
		".devcontainer/postCreate.sh",
		// Specify list of R packages
		"ggplot2",
		"gt",
		"httpgd",
		"languageserver",
		// Connects R terminals to the R extension (for `View()`, plots, and
		// the workspace viewer). Keep the tag equal to the pinned R extension
		// version below, or the extension prompts to install its own copy.
		"REditorSupport/vscode-R/sess@v3.0.1",
		"targets",
		"tibble"
	],

	// Configure tool-specific properties.
	"customizations": {
		// Settings for VS Code.
		"vscode": {
			"settings": {
				"editor.rulers": [80],
				"files.useExperimentalFileWatcher": true,
	    		"r.bracketedPaste": true,
				"r.lsp.promptToInstall": false,
	    		"r.plot.useHttpgd": true,
	    		"r.rterm.linux": "/root/.cargo/bin/arf",
	    		"r.sessionWatcher": true,
				// "R Terminal" is the profile that the R extension adds. It starts
				// `r.rterm.linux` (arf) connected to the extension, the same as
				// "R: Create R Terminal", so the "+" button opens a connected R
				// terminal too.
        		"terminal.integrated.defaultProfile.linux": "R Terminal",
				// Use the Air CLI that onCreate.sh installs on PATH instead of
				// the extension's bundled copy, so the editor formats R code with
				// the same version as the terminal and Claude Code's hook.
				"air.executableStrategy": "environment",
	    		"[r]": {
    			    "editor.formatOnSave": true,
    			    "editor.defaultFormatter": "Posit.air-vscode"
    			},
				// Formats each R chunk via the R formatter. onCreate.sh turns off
				// the R language server's formatting, so that Air is used instead.
    			"[quarto]": {
    			    "editor.formatOnSave": true,
    			    "editor.defaultFormatter": "quarto.quarto",
    			    "editor.wordWrap": "on"
    			},
    			"[markdown]": {
    			    "editor.wordWrap": "on"
    			}
			},
			// We also recommend installing the `tomoki1207.pdf` extension,
			// but it needs to be installed locally (not in Dev Container)
			"extensions": [
				"Anthropic.claude-code",
				"Posit.air-vscode",
				"quarto.quarto",
				"RDebugger.r-debugger",
				// Pinned so it can't drift from the `sess` tag above. Before
				// moving past 3.0.1: from 3.2.0 the extension matches `sess` by
				// a Git tree ID that sess/bootstrap.R stamps at build time, and
				// pak's GitHub tarball install has no .git to stamp it from.
				"REditorSupport.r@3.0.1"
			]
		}
	},

	// Connect as root user. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "root"
}
